# ==============================================================================
# Ganv Ki Bagiya — Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=generate-a-secure-random-key-for-production-min-50-characters
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,bagiya.org,www.bagiya.org

# Database Configuration
# Default: SQLite in project root if DATABASE_URL is unset
# PostgreSQL Example: postgres://bagiya_user:secure_password@localhost:5432/bagiya_db
DATABASE_URL=

# Razorpay Payment Gateway Credentials (Optional / Live Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Default Organization UPI Configuration (for direct QR generation)
DEFAULT_UPI_ID=bagiya@upi
DEFAULT_UPI_MERCHANT_NAME="Ganv Ki Bagiya Samiti"

# Email Configuration (SMTP for notification receipts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@bagiya.org
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="गाँव की बगिया <notifications@bagiya.org>"

# Security & Session Settings (Production)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
